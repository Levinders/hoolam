{
  "name": "hoolam",
  "version": "0.1.0",
  "description": "Hoolam: safe deals on WhatsApp (Phase 1 backend)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chat": "tsx scripts/chat.ts",
    "monnify:check": "tsx --env-file-if-exists=.env scripts/monnify-check.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "fastify": "^4.29.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
