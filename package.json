{
  "name": "hoolam",
  "version": "0.1.0",
  "description": "Hoolam: safe deals on WhatsApp (Phase 1 backend)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build:console",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p console/tsconfig.json",
    "chat": "tsx scripts/chat.ts",
    "monnify:check": "tsx --env-file-if-exists=.env scripts/monnify-check.ts",
    "build:console": "vite build --config console/vite.config.ts",
    "console:dev": "vite --config console/vite.config.ts",
    "console:demo": "tsx scripts/console-demo.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "fastify": "^5.12.5",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
