# ---- Server ----
PORT=3000
DATABASE_URL=postgresql://postgres.ecnyhalnekkwdhajxzij:Connect@711@TEST@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
PUBLIC_BASE_URL=https://your-domain.com
ADMIN_TOKEN=replace-with-a-long-random-string

# ---- WhatsApp Cloud API (Meta) ----
# Keep WHATSAPP_DRY_RUN=true until your Meta app is verified; messages are logged instead of sent.
WHATSAPP_DRY_RUN=true
WHATSAPP_VERIFY_TOKEN=any-string-you-choose
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_NUMBER=2349000000000
WHATSAPP_GRAPH_VERSION=v26.0

# ---- Payments ----
# fake = local testing, no real money. monnify = Monnify sandbox or live.
PAYMENT_PROVIDER=fake
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT=
# Sandbox webhooks are unsigned. Set to true in production.
MONNIFY_REQUIRE_SIGNATURE=false

# ---- Testing ----
# true = one phone can be both seller and buyer, and replying "paid" pretends the transfer landed.
# Only works with PAYMENT_PROVIDER=fake.
ALLOW_SELF_DEAL=false

# ---- Deals ----
CURRENCY=NGN
# Largest deal allowed before identity checks, in kobo (5000000 = ₦50,000)
MAX_DEAL_MINOR=5000000
NUDGE_AFTER_HOURS=24
FLAG_AFTER_HOURS=72
